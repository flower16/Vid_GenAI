DATABASE_URL=sqlite:///./solarbilliq.db
UPLOAD_DIR=./uploads

PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=solarbilliq-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
DEFAULT_NAMESPACE=oncor_solar_plans
UTILITY_AREA=Oncor

OPENAI_API_KEY=your-openai-key
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# LLM explanation (Claude Opus 4.8). Leave BLANK to use the deterministic
# fallback narration; set a real key to enable Claude-generated explanations.
ANTHROPIC_API_KEY=

CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Multi-agent coordinator — external project MCP servers (optional).
# Leave blank to have those domains report "not_connected". Use forward slashes
# and paths without spaces. Point at each project's own interpreter if it has a venv.
FINANCE_MCP_COMMAND=
HEALTHCARE_MCP_COMMAND=
